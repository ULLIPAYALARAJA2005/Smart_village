# =============================================================
# Smart Village – Django Backend Environment Variables
# Copy this file to .env and fill in real values
# =============================================================

# ---- Security ------------------------------------------------
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=False

# ---- Hosts ---------------------------------------------------
# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1

# ---- CORS / CSRF --------------------------------------------
# Comma-separated list of frontend origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:5173

# ---- Database (leave blank to use SQLite in development) -----
DB_NAME=smartvillage
DB_USER=smartvillage_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# ---- AI / Gemini API -----------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

